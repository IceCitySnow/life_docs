page {
  min-height: 100%;
  background: #f7f7f7;
  color: #222222;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.page {
  padding: 32rpx;
  padding-bottom: 48rpx;
}

.page-title {
  margin-bottom: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.page-desc {
  color: #666666;
  margin-bottom: 24rpx;
}

.state-box {
  margin-top: 80rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  color: #888888;
}

.state-box .state-title {
  font-size: 30rpx;
  color: #444444;
  margin-bottom: 12rpx;
}

.state-box .state-action {
  margin-top: 24rpx;
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #1f6f5b;
  color: #ffffff;
  font-size: 26rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #555555;
  border: 1rpx solid #e5e5e5;
  font-size: 24rpx;
}

.chip.active {
  background: #1f6f5b;
  color: #ffffff;
  border-color: #1f6f5b;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.card-meta {
  color: #888888;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.card-summary {
  color: #555555;
  font-size: 26rpx;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn {
  flex: 1;
  min-width: 160rpx;
  text-align: center;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: #eef6f3;
  color: #1f6f5b;
}

.btn.primary {
  background: #1f6f5b;
  color: #ffffff;
}

.btn.danger {
  background: #fdecec;
  color: #c0392b;
}

.btn.disabled {
  opacity: 0.5;
}

.section-title {
  margin: 32rpx 0 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #666666;
  font-size: 22rpx;
}
