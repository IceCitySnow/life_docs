<view class="page">
  <view class="page-title">我的</view>
  <view class="page-desc">资料、收藏、愿望与回忆。</view>

  <view class="state-box" wx:if="{{loading}}">
    <view class="state-title">加载中…</view>
  </view>

  <view class="state-box" wx:elif="{{error}}">
    <view class="state-title">需要登录</view>
    <view>{{error}}</view>
    <view class="state-action" bindtap="onRelogin">重新登录</view>
    <view class="state-action" bindtap="onRetry" style="margin-top:16rpx;">重试</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="card-title">{{displayName}}</view>
      <view class="card-meta">角色 {{role}}</view>
      <view class="btn-row">
        <view class="btn {{busy ? 'disabled' : ''}}" bindtap="onRelogin">重新登录</view>
        <view class="btn danger {{busy ? 'disabled' : ''}}" bindtap="onLogout">退出登录</view>
      </view>
      <view class="btn-row">
        <view class="btn danger {{busy ? 'disabled' : ''}}" bindtap="onDeleteAccount">注销账号</view>
      </view>
    </view>

    <view class="section-title">收藏</view>
    <view class="state-box" wx:if="{{!favorites.length}}" style="margin-top:0;padding:24rpx;">
      <view>还没有收藏任务</view>
    </view>
    <view
      class="card"
      wx:for="{{favorites}}"
      wx:key="taskId"
      data-id="{{item.taskId}}"
      bindtap="onOpenTask"
    >
      <view class="card-title">{{item.title}}</view>
      <view class="card-summary">{{item.summary}}</view>
    </view>

    <view class="section-title">自定义愿望</view>
    <view class="card">
      <input
        class="wish-input"
        placeholder="写下一个想体验的事"
        value="{{wishDraft}}"
        bindinput="onWishInput"
      />
      <view class="btn-row">
        <view class="btn primary {{busy ? 'disabled' : ''}}" bindtap="onCreateWish">添加愿望</view>
      </view>
    </view>
    <view class="card" wx:for="{{wishes}}" wx:key="id">
      <view class="card-title">{{item.title}}</view>
      <view class="card-meta">{{item.statusText}}<text wx:if="{{item.completedText}}"> · {{item.completedText}}</text></view>
      <view class="btn-row">
        <view
          class="btn {{busy || item.completedAt ? 'disabled' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCompleteWish"
        >标记完成</view>
        <view class="btn danger {{busy ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="onDeleteWish">删除</view>
      </view>
    </view>

    <view class="section-title">我的回忆</view>
    <view class="state-box" wx:if="{{!records.length}}" style="margin-top:0;padding:24rpx;">
      <view>还没有回忆记录</view>
    </view>
    <view class="card" wx:for="{{records}}" wx:key="id">
      <view class="card-title">{{item.titleSnapshot}}</view>
      <view class="card-meta">{{item.visibilityText}} · {{item.createdText}}</view>
      <view class="card-summary" wx:if="{{item.reflectionText}}">{{item.reflectionText}}</view>
      <view class="btn-row">
        <view
          class="btn {{busy ? 'disabled' : ''}}"
          data-id="{{item.id}}"
          bindtap="onToggleRecordVisibility"
        >{{item.visibility === 'PUBLIC' ? '改回私密' : '公开到发现'}}</view>
        <view class="btn danger {{busy ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="onDeleteRecord">删除回忆</view>
      </view>
    </view>
  </block>
</view>
