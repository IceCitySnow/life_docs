# Root convenience sample. The backend reads backend/.env.
# Copy backend/.env.example to backend/.env before starting the API.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://life_exploration:life_exploration_dev@localhost:5432/life_exploration?schema=public
AUTH_TOKEN_TTL_SECONDS=604800
ENABLE_DEV_AUTH=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
LOG_LEVEL=debug
