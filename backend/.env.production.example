# Production / staging sample. Copy to backend/.env.production (never commit secrets).
# Used by docker compose -f docker-compose.prod.yml --env-file backend/.env.production

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info

# Compose injects DATABASE_URL for the api service from these values.
POSTGRES_USER=life_exploration
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=life_exploration

# If you run the Node process without Compose, set DATABASE_URL yourself and
# point it at a private PostgreSQL instance (not publicly reachable).
# DATABASE_URL=postgresql://life_exploration:replace-with-strong-password@127.0.0.1:5432/life_exploration?schema=public

AUTH_TOKEN_TTL_SECONDS=604800
ENABLE_DEV_AUTH=false

# Required in production (server-side WeChat code2session).
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=replace-with-wechat-app-secret

# Public HTTPS origin registered in WeChat mini program admin console.
PUBLIC_API_BASE_URL=https://api.example.com/api/v1
