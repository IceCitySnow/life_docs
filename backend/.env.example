# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL (local native install or Docker Compose)
DATABASE_URL=postgresql://life_exploration:life_exploration_dev@localhost:5432/life_exploration?schema=public

# Auth
# Session TTL in seconds (default 7 days)
AUTH_TOKEN_TTL_SECONDS=604800
# Dev-only test login endpoint POST /auth/dev-login. Must stay false in production.
ENABLE_DEV_AUTH=true
# Required in production. Used only on the server for code2session.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Logging
LOG_LEVEL=debug

# Optional: public API origin for ops docs / mini program production config
# PUBLIC_API_BASE_URL=https://api.example.com/api/v1
